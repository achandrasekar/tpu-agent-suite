{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "arm"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "invalid_input",
        "needs_input",
        "failed",
        "blocked"
      ],
      "description": "Execution status of the arm."
    },
    "arm": {
      "type": "string",
      "minLength": 1,
      "description": "Stable identifier of the executed arm."
    },
    "verdict": {
      "type": "string",
      "enum": [
        "win",
        "tie",
        "loss",
        "invalid"
      ],
      "description": "Empirical verdict against baseline and admissibility gates."
    },
    "execution_id": {
      "type": "string",
      "minLength": 1,
      "description": "The physical accelerator compute job ID."
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value",
        "replicates",
        "provenance"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        },
        "replicates": {
          "type": "integer",
          "minimum": 1
        },
        "delta_pct": {
          "type": "number"
        },
        "provenance": {
          "type": "string",
          "enum": [
            "measured",
            "inferred",
            "modeled",
            "projected"
          ]
        }
      }
    },
    "gates": {
      "type": "array",
      "description": "Evaluated admissibility gates measured co-located with the metric.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "passed",
          "execution_id"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "passed": {
            "type": "boolean"
          },
          "value": {
            "type": "number"
          },
          "execution_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "description": "Durable artifact paths produced by the execution.",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string",
      "description": "One-line narrative summary of the execution outcome."
    }
  },
  "examples": [
    {
      "status": "completed",
      "arm": "a1",
      "verdict": "win",
      "execution_id": "job-20260922-001",
      "metric": {
        "name": "tokens_per_s",
        "value": 42500.0,
        "unit": "tok/s",
        "replicates": 3,
        "delta_pct": 6.25,
        "provenance": "measured"
      },
      "gates": [
        {
          "name": "eval_loss",
          "passed": true,
          "value": 2.14,
          "execution_id": "job-20260922-001"
        }
      ],
      "artifacts": [
        "artifacts/a1_xprof.pb"
      ],
      "summary": "Arm a1 win: +6.25% tokens/s with clean eval_loss pass."
    }
  ]
}
