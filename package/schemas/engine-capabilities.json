{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "image",
    "outcome",
    "capabilities"
  ],
  "description": "Output of `deploy probe`: which llm-d-relevant modules the serving image carries. A sanity check that marks arms blocked, not a gate on the study.",
  "properties": {
    "schema": {
      "type": "string",
      "const": "engine-capabilities"
    },
    "probed_at": {
      "type": "string"
    },
    "image": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "job",
        "exec",
        "sim"
      ],
      "description": "`job` ran a probe Job on a TPU node (managed fleet); `exec` ran inside a serving pod (adopted fleet)."
    },
    "pod": {
      "type": [
        "string",
        "null"
      ],
      "description": "Pod the exec-mode probe ran in."
    },
    "accelerator": {
      "type": "object"
    },
    "outcome": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "timeout",
        "sim"
      ],
      "description": "`sim`: the image is the simulator; capabilities are declared, not probed."
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "pd_connector": {
          "type": "boolean"
        },
        "offload_connector": {
          "type": "boolean"
        },
        "kv_events": {
          "type": "boolean"
        },
        "tpu_inference": {
          "type": "boolean"
        },
        "vllm": {
          "type": "boolean"
        },
        "vllm_torchtpu": {
          "type": "boolean"
        },
        "sim": {
          "type": "boolean",
          "description": "The image is llm-d-inference-sim: a simulated fleet. P/D works through the routing sidecar's generic path; precise routing and host tiering do not exist."
        }
      }
    },
    "versions": {
      "type": "object"
    },
    "modules": {
      "type": "object"
    },
    "log_tail": {
      "type": "string"
    }
  }
}
