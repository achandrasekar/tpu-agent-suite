{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "topology",
    "kv",
    "router",
    "engine"
  ],
  "description": "The incumbent: one document that fully determines a deployment. Hot paths (router.*) change with an EPP reload, warm paths (engine.*, kv.block_size) with a rolling restart, everything else is cold and needs a new release.",
  "properties": {
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "decode"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "aggregated",
            "disaggregated"
          ],
          "description": "disaggregated renders a prefill pool and a decode pool; decode pods carry the llm-d routing sidecar and the EPP runs the disagg-profile-handler."
        },
        "decode": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "replicas"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "tp": {
              "type": "integer",
              "minimum": 1
            },
            "slice": {
              "type": "string"
            },
            "hosts": {
              "type": "integer",
              "minimum": 1,
              "description": "Hosts per replica. 1 renders a Deployment; more renders a LeaderWorkerSet group of this size, which needs accelerator.chips_per_host and a worker_command in the recipe."
            },
            "engine": {
              "type": "object",
              "additionalProperties": false,
              "description": "Per-pool overlay on `engine`, same whitelist. Prefill wants large batched-token budgets, decode wants many sequences; a key set to null removes the fleet default for this pool.",
              "properties": {
                "max_num_seqs": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "max_num_batched_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "gpu_memory_utilization": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "kv_cache_dtype": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max_model_len": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "async_scheduling": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          }
        },
        "prefill": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 1
            },
            "tp": {
              "type": "integer",
              "minimum": 1
            },
            "slice": {
              "type": "string"
            },
            "hosts": {
              "type": "integer",
              "minimum": 1,
              "description": "Hosts per replica. 1 renders a Deployment; more renders a LeaderWorkerSet group of this size, which needs accelerator.chips_per_host and a worker_command in the recipe."
            },
            "engine": {
              "type": "object",
              "additionalProperties": false,
              "description": "Per-pool overlay on `engine`, same whitelist. Prefill wants large batched-token budgets, decode wants many sequences; a key set to null removes the fleet default for this pool.",
              "properties": {
                "max_num_seqs": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "max_num_batched_tokens": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "gpu_memory_utilization": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1
                },
                "kv_cache_dtype": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "max_model_len": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 1
                },
                "async_scheduling": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                }
              }
            }
          },
          "additionalProperties": false
        },
        "pd_decider": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "always-disagg-pd-decider",
                "prefix-based-pd-decider"
              ]
            },
            "parameters": {
              "type": "object",
              "description": "Decider parameters, e.g. prefix-based-pd-decider's nonCachedTokens / promptTokens."
            }
          },
          "description": "Which requests take the prefill hop. Default always-disagg-pd-decider (the llm-d P/D guide); prefix-based-pd-decider with nonCachedTokens is the inner-sweep knob."
        }
      }
    },
    "kv": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "precise_routing": {
          "type": "boolean"
        },
        "block_size": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "tiered_host": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "cpu_chunks": {
              "type": "integer",
              "minimum": 1,
              "description": "TPU_OFFLOAD_NUM_CPU_CHUNKS (tpu-inference); host KV capacity in chunks."
            },
            "staging_blocks": {
              "type": "integer",
              "minimum": 1,
              "description": "TPU_OFFLOAD_NUM_STAGING_BLOCKS (tpu-inference)."
            },
            "module": {
              "type": "string",
              "description": "kv_connector_module_path override; default from the recipe's engine_flavor."
            },
            "connector": {
              "type": "string",
              "description": "kv_connector class override."
            },
            "extra_config": {
              "type": "object",
              "description": "kv_connector_extra_config passed verbatim (e.g. the torchtpu raiden connector's cpu_bytes_to_use)."
            },
            "env": {
              "type": "object",
              "additionalProperties": {
                "type": [
                  "string",
                  "number",
                  "boolean"
                ]
              },
              "description": "Extra pod env the connector reads."
            }
          },
          "description": "Host-tier KV offload. Null means HBM only."
        },
        "pd_connector": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "module": {
              "type": "string"
            },
            "connector": {
              "type": "string"
            },
            "sidecar_connector": {
              "type": "string",
              "enum": [
                "nixlv2",
                "shared-storage",
                "sglang",
                "mooncake",
                "offloading"
              ],
              "description": "The routing sidecar's --kv-connector; the TPU guide leaves the default nixlv2."
            },
            "extra_config": {
              "type": "object"
            }
          },
          "description": "P/D KV connector override; defaults come from the recipe's engine_flavor."
        }
      }
    },
    "router": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile"
      ],
      "properties": {
        "profile": {
          "type": "string",
          "enum": [
            "passthrough",
            "sticky-until-saturated",
            "prefix-weighted",
            "load-only",
            "session-sticky",
            "agentx-turn-priority",
            "agentx-session-affinity"
          ],
          "description": "passthrough: no EPP; requests go to the model-server Service and kube-proxy spreads them. It is the control every router arm is measured against and the baseline of an adopted fleet. The others name an EndpointPickerConfig the renderer carries. agentx-turn-priority / agentx-session-affinity are the two InferenceX AgentX EndpointPickerConfigs (llm-d.ai/v1: P/D, per-profile session affinity, active-request scoring; the first with flow control and program-aware fairness, the second without), rendered as written; they need `recipe.router_images` pointing at llm-d-router main and a disaggregated topology."
        },
        "plugins": {
          "type": "object",
          "description": "Per-plugin parameter overrides keyed by plugin type, e.g. {\"prefix-cache-affinity-filter\": {\"peakPrefillThroughput\": 27336}, \"token-load-scorer\": {\"weight\": 1.5}}. 'weight' applies to the scheduling-profile entry; every other key is a plugin parameter."
        },
        "flow_control": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "properties": {
            "saturation_detector": {
              "type": "object",
              "description": "{type: utilization-detector|concurrency-detector|max-saturation-detector, ...parameters} e.g. {type: utilization-detector, queueDepthThreshold: 5, kvCacheUtilThreshold: 0.8}."
            },
            "max_requests": {
              "type": "integer",
              "minimum": 0
            },
            "max_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "default_request_ttl": {
              "type": "string",
              "description": "Go duration, e.g. 60s."
            },
            "enable_eviction": {
              "type": "boolean"
            },
            "priority_bands": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "priority"
                ],
                "properties": {
                  "priority": {
                    "type": "integer"
                  },
                  "max_requests": {
                    "type": "integer"
                  },
                  "max_bytes": {
                    "type": "integer"
                  },
                  "ordering_policy": {
                    "type": "string"
                  },
                  "fairness_policy": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "description": "EPP flow control (featureGates: [flowControl] + flowControl block). Null means off: a saturated pool only sheds negative-priority requests."
        },
        "predicted_latency": {
          "type": "boolean",
          "description": "Adds the predicted-latency producer, latency scorer, SLO headroom filter and admitter, and enables the chart's latencyPredictor sidecars. Alpha in router v0.11.0."
        },
        "epp_replicas": {
          "type": "integer",
          "minimum": 1
        },
        "epp_ha_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "active-passive",
            "active-active",
            null
          ],
          "description": "With epp_replicas > 1 the chart enables leader election (active-passive) by itself; active-active turns it off."
        },
        "proxy_mode": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "sidecar",
            "service",
            null
          ]
        },
        "proxy_replicas": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "description": "The fleet-tunable whitelist. Anything else is a recommendation for the engine-optimization domain.",
      "properties": {
        "max_num_seqs": {
          "type": "integer",
          "minimum": 1
        },
        "max_num_batched_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_memory_utilization": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "kv_cache_dtype": {
          "type": "string"
        },
        "max_model_len": {
          "type": "integer",
          "minimum": 1
        },
        "async_scheduling": {
          "type": "boolean"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "arm": {
          "type": "string"
        },
        "execution_id": {
          "type": "string"
        },
        "metric": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": "number"
            },
            "provenance": {
              "type": "string",
              "enum": [
                "measured",
                "inferred",
                "modeled",
                "projected"
              ]
            }
          }
        },
        "promoted_from": {
          "type": [
            "object",
            "null"
          ]
        },
        "harness_digest": {
          "type": "string",
          "description": "release.harness_digest of the measurement this config's metric came from: the load-generator/router sizing, shard count and harness image. An arm measured by a different apparatus is not comparable to it."
        }
      }
    }
  },
  "examples": [
    {
      "topology": {
        "mode": "aggregated",
        "decode": {
          "replicas": 5,
          "tp": 8,
          "slice": "2x2x1"
        },
        "prefill": null
      },
      "kv": {
        "precise_routing": false,
        "block_size": null,
        "tiered_host": null,
        "pd_connector": null
      },
      "router": {
        "profile": "sticky-until-saturated",
        "plugins": {
          "prefix-cache-affinity-filter": {
            "peakPrefillThroughput": 27336
          }
        },
        "flow_control": null,
        "predicted_latency": false,
        "epp_replicas": 1
      },
      "engine": {
        "max_num_seqs": 256
      },
      "provenance": {
        "arm": "baseline",
        "execution_id": "20260914T120000Z-1a2b3c4d",
        "metric": {
          "name": "goodput_at_slo_per_chip",
          "value": 0.71,
          "provenance": "measured"
        }
      }
    }
  ]
}
