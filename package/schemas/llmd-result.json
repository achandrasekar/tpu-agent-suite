{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status"
  ],
  "properties": {
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "invalid_input",
        "needs_input",
        "failed",
        "blocked"
      ],
      "description": "Outcome of this ONE round. 'completed' means the round advanced the study and wrote the ledger; the study may still be open."
    },
    "study_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "round": {
      "type": "integer",
      "minimum": 0
    },
    "study_status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "ready_to_promote",
        "promoted",
        "engine_escalation"
      ],
      "description": "'ready_to_promote' is 'closed' plus an admissible incumbent that beat the baseline; production still needs a separate request with promotion_approved. 'promoted' means a later request with promotion_approved moved the incumbent to production and the bundle exists. `engine_escalation`: the fleet search plateaued with the objective unmet and the round opened an engine study for tpu-performance (see engine_escalation); the fleet study stays open and resumes when the caller comes back with engine_study_id."
    },
    "incumbent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arm_id",
        "config_path"
      ],
      "properties": {
        "arm_id": {
          "type": "string",
          "minLength": 1
        },
        "config_path": {
          "type": "string",
          "minLength": 1,
          "description": "The incumbent llmd-config.json under the run's artifacts."
        },
        "score": {
          "type": "number",
          "description": "Primary-metric value of the incumbent, as measured."
        },
        "metric": {
          "type": "string"
        },
        "chips_total": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "recommendations": {
      "type": "array",
      "description": "Findings for other domains, never acted on here. Each names the domain and the operating point it should be measured at.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "domain",
          "finding"
        ],
        "properties": {
          "domain": {
            "type": "string",
            "enum": [
              "tpu-performance",
              "tpu-onboarding",
              "tpu-kernel",
              "platform"
            ]
          },
          "finding": {
            "type": "string",
            "minLength": 1
          },
          "operating_point": {
            "type": "object"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "summary": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "production": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "promoted",
            "refused",
            "acceptance_failed",
            "failed"
          ],
          "description": "llmd-productionizer's status, copied verbatim."
        },
        "release_name": {
          "type": "string"
        },
        "namespace": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "bundle_path": {
          "type": "string"
        },
        "unverified": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "Present only on a request that carried promotion_approved: true. Where the production release and its handoff bundle are, or why promotion did not happen."
    },
    "engine_escalation": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Present when study_status is engine_escalation.",
      "properties": {
        "engine_study_id": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "request_path": {
          "type": "string",
          "description": "The engine-escalation.json the caller hands to tpu-performance rounds."
        },
        "mode": {
          "type": "string",
          "enum": [
            "approve",
            "auto"
          ]
        },
        "escalation": {
          "type": "integer"
        },
        "summary": {
          "type": "string"
        }
      }
    },
    "recipe_bump": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "description": "Present on the re-entry round after an engine study closed: what came back into the recipe.",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "bumped",
            "no_win",
            "no_delta"
          ]
        },
        "recipe_path": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "engine_study_id": {
          "type": "string"
        },
        "successor_study_id": {
          "type": "string",
          "description": "The fleet study the search continues in after a bump; the predecessor is closed with the bump as its outcome."
        }
      }
    }
  },
  "examples": [
    {
      "status": "completed",
      "study_id": "acme-chat-tpu7x",
      "round": 3,
      "study_status": "open",
      "incumbent": {
        "arm_id": "a2",
        "config_path": "artifacts/llmd/incumbent/llmd-config.json",
        "score": 0.83,
        "metric": "goodput_at_slo_per_chip",
        "chips_total": 20
      },
      "recommendations": [],
      "summary": "Arm a2 (topology.replicas 6->5 with max_num_seqs 256) win +16.9%.",
      "artifacts": []
    }
  ]
}
