{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["prompt", "study_id"],
  "properties": {
    "prompt": { "type": "string" },
    "study_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "description": "Slug of the study this round advances. Required: a round never invents or infers one, because a round that opens the wrong study spends a real budget against the wrong plan."
    },
    "run_id": { "type": "string" }
  },
  "examples": [
    {
      "prompt": "Advance one round.",
      "study_id": "qwen35-397b-ttft",
      "run_id": "20260914T120000Z-000000000000"
    }
  ]
}
